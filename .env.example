# Copy to .env and fill in. If a model call fails (or has no key), that column falls back to native search.
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=

# Optional overrides
# HAIKU_MODEL=claude-haiku-5-5
# JEV_MODEL=jev-latest
# Jev pricing: $0.042 per 1M input tokens, output tokens free.
# JEV_PRICE_IN_PER_M=0.042
# JEV_PRICE_OUT_PER_M=0
